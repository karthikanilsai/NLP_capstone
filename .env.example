# Create API keys at https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Optional additional keys are tried if a key/model combination is unavailable.
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=

# Optional model override; remaining Gemini models are used as fallbacks.
GEMINI_MODEL=gemini-3.5-flash-lite

APP_URL=http://localhost:3000
PORT=3000

# Python NLP service
PYTHON_NLP_PORT=8001
# Optional; examples: python (Windows) or python3 (macOS/Linux)
# PYTHON_EXECUTABLE=python
